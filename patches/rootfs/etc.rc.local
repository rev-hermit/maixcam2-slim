#!/bin/bash

mkdir -p /opt/data/AXSyslog/kernel

bash /etc/init.d/axemac.sh

chmod 755 /soc/scripts/auto_load_all_drv.sh
bash /soc/scripts/auto_load_all_drv.sh
# restore system clock from RTC (UTC), after the RTC driver is loaded
/sbin/hwclock --hctosys --utc 2>/dev/null || true

chmod 755 /soc/scripts/npu_set_bw_limiter.sh
bash /soc/scripts/npu_set_bw_limiter.sh start

bash /etc/init.d/axsyslogd start
bash /etc/init.d/axklogd start
chmod 755 /etc/init.d/S99checkboot
bash /etc/init.d/S99checkboot start
chmod 755 /etc/init.d/S99checkota
bash /etc/init.d/S99checkota start
